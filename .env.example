# 复制为 .env 后填入真实值；.env 不会提交到版本库
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
REQUEST_TIMEOUT=60

# 飞书机器人（不启动机器人时可留空）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 部门权限本地测试映射（JSON，可选；真实飞书 open_id 可追加）
# TEST_USER_DEPARTMENTS={"ou_xxxxxxxx": "finance"}

# RAG 配置（以下均为默认值，可按需覆盖）
KNOWLEDGE_BASE_DIR=knowledge_base
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=enterprise_knowledge_base
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.4
CHUNK_SIZE=500
CHUNK_OVERLAP=80
